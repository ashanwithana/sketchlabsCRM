{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app-company",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "STORAGE_BUCKET",
      "bucket_name": "company-storage"
    }
  ],
  "triggers": {
    "crons": [
      "0 4 * * *"
    ]
  }
}
