# Copy to .env and change every value.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres"
SESSION_SECRET=""
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-to-a-long-password"
# Optional SMTP. Leave SMTP_HOST empty to use the dev outbox (emails saved to storage/outbox).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# Optional: Use EmailJS for email delivery instead of SMTP
# Get credentials from https://www.emailjs.com/
EMAILJS_SERVICE_ID=""
EMAILJS_TEMPLATE_ID=""
EMAILJS_PUBLIC_KEY=""
APP_URL="http://localhost:3000"
# Optional: path to a Chrome or Chromium binary for PDF rendering (auto-detected on macOS).
PDF_CHROME_PATH=""
# Optional: where logos, signatures, PDFs, and the dev outbox are stored (default: storage).
# STORAGE_DIR="storage"
# Optional: where backups are written (default: backups).
# BACKUP_DIR="backups"
# Sender shown on email (SMTP_FROM). Defaults to the company email when empty.